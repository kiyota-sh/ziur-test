@typeparam TColumn

<th style="cursor: pointer; user-select: none;"
    aria-sort="@AriaSort"
    @onclick="() => OnSort.InvokeAsync(Column)">
    @Title <span aria-hidden="true">@Indicator</span>
</th>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public TColumn Column { get; set; } = default!;
    [Parameter, EditorRequired] public TColumn CurrentColumn { get; set; } = default!;
    [Parameter] public bool Ascending { get; set; } = true;
    [Parameter] public EventCallback<TColumn> OnSort { get; set; }

    private bool IsActive => EqualityComparer<TColumn>.Default.Equals(Column, CurrentColumn);
    private string Indicator => IsActive ? (Ascending ? "▲" : "▼") : "";
    private string AriaSort => IsActive ? (Ascending ? "ascending" : "descending") : "none";
}